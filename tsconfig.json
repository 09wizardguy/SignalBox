{
    "compilerOptions": {
        "strict": true,
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "ignoreDeprecations": "6.0",
        "noEmit": true
    }
}
